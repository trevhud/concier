{
  "name": "concier-mcp-server",
  "version": "1.0.0",
  "description": "Travel booking MCP server with TypeScript",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:frontend": "cd frontend && npm run build",
    "build:all": "npm run build:frontend && npm run build",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/index.ts --http",
    "dev:full": "npm run build:frontend && npm run dev:http",
    "dev:hmr": "concurrently --names \"SERVER,FRONTEND\" --prefix-colors \"cyan,magenta\" \"npm run dev:http\" \"npm run watch:frontend\"",
    "watch:frontend": "chokidar \"frontend/src/**/*\" -c \"npm run build:frontend\"",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "start:full": "npm run build:all && npm run start:http",
    "start:frontend": "cd frontend && npm start",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:all": "tsx src/tests/test-runner.ts all",
    "test:flights": "tsx src/tests/test-runner.ts flights",
    "test:integration": "tsx src/tests/test-runner.ts integration",
    "test:e2e": "tsx src/tests/test-runner.ts e2e",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "travel",
    "booking",
    "typescript"
  ],
  "author": "Trevor Hudson",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.28.0",
    "@duffel/api": "^4.13.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@supabase/supabase-js": "^2.51.0",
    "@types/uuid": "^10.0.0",
    "amadeus": "^11.0.0",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "uuid": "^11.1.0",
    "ws": "^8.18.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
